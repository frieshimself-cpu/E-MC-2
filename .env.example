# ---- Frontend (baked in at build time — changing these requires a redeploy) ----

# Your pump.fun mint address. Leave unset to keep the current default token;
# set to "" for pre-launch teaser mode ("drops at launch", buy disabled);
# set to your mint the moment you deploy the token.
VITE_MINT=

# Launch moment in ms since epoch (run `Date.now()` in a browser console at launch).
# Drives the fallback "Compounds" counter until the stats bot reports real numbers.
VITE_LAUNCH_TS=

# Compound cycle in minutes (countdown clock + copy). Default: 10
VITE_COMPOUND_MINUTES=

# ---- Serverless /api/stats (read at request time — no redeploy needed) ----

# Upstash Redis REST credentials; the compound bot writes its totals here and
# api/stats.js serves them. Without these the stats card falls back cleanly.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Redis key holding the stats JSON blob. Default: emc2:stats
STATS_KEY=
